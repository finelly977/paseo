diff --git a/node_modules/app-builder-lib/templates/nsis/include/installUtil.nsh b/node_modules/app-builder-lib/templates/nsis/include/installUtil.nsh
--- a/node_modules/app-builder-lib/templates/nsis/include/installUtil.nsh
+++ b/node_modules/app-builder-lib/templates/nsis/include/installUtil.nsh
@@ -83,11 +83,25 @@
 
 Var /GLOBAL isTryToKeepShortcuts
 
-!macro setIsTryToKeepShortcuts
+!macro setIsTryToKeepShortcuts ROOT_KEY
   StrCpy $isTryToKeepShortcuts "true"
   !ifdef allowToChangeInstallationDirectory
     ${ifNot} ${isUpdated}
       StrCpy $isTryToKeepShortcuts "false"
+      # 手动升级也保留同目录的快捷方式；变更安装目录仍走重建路径。
+      Push $R5
+      Push $R6
+      !insertmacro readReg $R5 "${ROOT_KEY}" "${INSTALL_REGISTRY_KEY}" InstallLocation
+      ${if} $R5 != ""
+      ${andIf} ${FileExists} "$R5\${APP_EXECUTABLE_FILENAME}"
+        GetFullPathName $R5 "$R5\."
+        GetFullPathName $R6 "$INSTDIR\."
+        ${if} $R5 == $R6
+          StrCpy $isTryToKeepShortcuts "true"
+        ${endif}
+      ${endif}
+      Pop $R6
+      Pop $R5
     ${endIf}
   !endif
 !macroend
